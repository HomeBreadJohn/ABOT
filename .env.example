# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Provider mode for the document pipeline: "mock" (default) or "lumen".
PROVIDER_MODE=

# Required only when PROVIDER_MODE=lumen. Base URLs must be https.
LUMEN_API_KEY=
LUMEN_API_SECRET=
LUMEN_OCR_BASE_URL=
LUMEN_AI_CHAT_BASE_URL=
LUMEN_AI_INSTANCE_ID=

# Server-only secret the background job tick route compares against.
JOB_RUNNER_SECRET=
